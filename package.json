{
  "name": "hexo-cli",
  "version": "4.3.2",
  "description": "Command line interface for Hexo",
  "type": "module",
  "main": "dist/hexo.cjs",
  "module": "dist/hexo.js",
  "bin": {
    "hexo": "./bin/hexo.js"
  },
  "files": [
    "dist/**",
    "completion",
    "bin",
    "assets"
  ],
  "types": "./dist/hexo.d.ts",
  "scripts": {
    "prepublishOnly": "npm install && npm run clean && npm run build",
    "build": "node build.js && node scripts/build_exports.mjs",
    "clean": "rimraf dist && npm run build",
    "eslint": "eslint lib test",
    "pretest": "npm run clean && npm run build",
    "test": "mocha test/**/*.ts --require ts-node/register",
    "test-cov": "nyc --reporter=lcovonly npm test",
    "prepare": "git submodule init && git submodule update && git submodule foreach git pull origin master"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hexojs/hexo-cli.git"
  },
  "homepage": "https://hexo.io/",
  "keywords": [
    "website",
    "blog",
    "cms",
    "framework",
    "hexo",
    "cli"
  ],
  "author": "Tommy Chen <tommy351@gmail.com> (https://zespia.tw)",
  "maintainers": [
    "Abner Chou <hi@abnerchou.me> (https://abnerchou.me)"
  ],
  "license": "MIT",
  "dependencies": {
    "abbrev": "^2.0.0",
    "bluebird": "^3.7.2",
    "command-exists": "^1.2.9",
    "hexo-fs": "^5.0.1",
    "hexo-log": "^4.0.1",
    "hexo-util": "^4.0.0",
    "minimist": "^1.2.5",
    "picocolors": "^1.1.1",
    "resolve": "^1.20.0",
    "tildify": "^2.0.0"
  },
  "devDependencies": {
    "@types/abbrev": "^1.1.5",
    "@types/bluebird": "^3.5.37",
    "@types/chai": "^4.3.14",
    "@types/command-exists": "^1.2.3",
    "@types/minimist": "^1.2.5",
    "@types/mocha": "^10.0.6",
    "@types/node": "^22.7.4",
    "@types/resolve": "^1.20.6",
    "@types/rewire": "^2.5.30",
    "@types/sinon": "^17.0.3",
    "binary-collections": "^2.0.10",
    "chai": "^4.3.4",
    "eslint": "^9.39.1",
    "eslint-config-hexo": "^6.0.0",
    "hexo-renderer-marked": "^7.0.1",
    "mocha": "^11.7.5",
    "nyc": "^15.1.0",
    "rewire": "^9.0.1",
    "sinon": "^17.0.1",
    "ts-node": "^10.9.1",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=20"
  },
  "exports": {
    ".": {
      "import": "./dist/hexo.js",
      "require": "./dist/hexo.cjs",
      "types": "./dist/hexo.d.ts"
    },
    "./dist/console": {
      "import": "./dist/console/index.js",
      "require": "./dist/console/index.cjs",
      "types": "./dist/console/index.d.ts"
    },
    "./dist/console/help": {
      "import": "./dist/console/help.js",
      "require": "./dist/console/help.cjs",
      "types": "./dist/console/help.d.ts"
    },
    "./dist/console/index": {
      "import": "./dist/console/index.js",
      "require": "./dist/console/index.cjs",
      "types": "./dist/console/index.d.ts"
    },
    "./dist/console/init": {
      "import": "./dist/console/init.js",
      "require": "./dist/console/init.cjs",
      "types": "./dist/console/init.d.ts"
    },
    "./dist/console/version": {
      "import": "./dist/console/version.js",
      "require": "./dist/console/version.cjs",
      "types": "./dist/console/version.d.ts"
    },
    "./dist/context": {
      "import": "./dist/context.js",
      "require": "./dist/context.cjs",
      "types": "./dist/context.d.ts"
    },
    "./dist/extend/console": {
      "import": "./dist/extend/console.js",
      "require": "./dist/extend/console.cjs",
      "types": "./dist/extend/console.d.ts"
    },
    "./dist/find_pkg": {
      "import": "./dist/find_pkg.js",
      "require": "./dist/find_pkg.cjs",
      "types": "./dist/find_pkg.d.ts"
    },
    "./dist/goodbye": {
      "import": "./dist/goodbye.js",
      "require": "./dist/goodbye.cjs",
      "types": "./dist/goodbye.d.ts"
    },
    "./dist/hexo": {
      "import": "./dist/hexo.js",
      "require": "./dist/hexo.cjs",
      "types": "./dist/hexo.d.ts"
    },
    "./dist/types": {
      "import": "./dist/types.js",
      "require": "./dist/types.cjs",
      "types": "./dist/types.d.ts"
    }
  }
}
