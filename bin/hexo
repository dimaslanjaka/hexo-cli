#!/usr/bin/env node

// eslint-disable-next-line strict
'use strict';

// Detect runtime: if `require` is available, we're in CommonJS; otherwise use ESM dynamic import.
if (typeof require === 'function' && typeof module === 'object' && module.exports) {
  console.log('Running in CommonJS environment');
  require('../dist/hexo.cjs')();
} else {
  // ESM runtime: prefer loading the CommonJS bundle via `createRequire`.
  (async () => {
    try {
      console.log('Running in ESM environment with CommonJS bundle');
      const { createRequire } = await import('module');
      const requireFunc = createRequire(import.meta.url);
      requireFunc('../dist/hexo.cjs')();
    } catch (err) {
      console.log('Falling back to ESM dynamic import');
      // Fallback to ESM dynamic import if requiring the CJS bundle fails.
      await import('../dist/hexo.js')
        .then((lib) => {
          const mod = lib.default || lib;
          mod();
        })
        .catch((e) => {
          // eslint-disable-next-line no-console
          console.error(e);
          process.exit(1);
        });
    }
  })();
}
